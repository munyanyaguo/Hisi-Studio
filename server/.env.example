# Hisi Studio Backend Environment Variables
# Copy this file to .env and fill in the values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hisi_studio

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173

# Flutterwave Payment Gateway
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_SECRET_HASH=

# Email Configuration (SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@hisistudio.com
ADMIN_EMAIL=admin@hisistudio.com

# SendGrid (Alternative email provider - production)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

# Cloudinary (Media storage - production)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Redis (Optional - for caching)
# REDIS_URL=redis://localhost:6379/0

# Exchange Rate API (Optional)
# EXCHANGE_RATE_API_KEY=

# Site Configuration
SITE_LOGO_URL=https://hisistudio.com/logo.png
